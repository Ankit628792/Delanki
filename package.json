{
  "name": "delanki",
  "private": true,
  "version": "3.2.0",
  "description": "Delanki — Digital Product Development Studio building web applications, mobile apps, extensions, and software products.",
  "license": "UNLICENSED",
  "author": "Delanki Studio & Ankit",
  "keywords": [
    "delanki",
    "product-studio",
    "digital-agency",
    "software-development",
    "mobile-apps",
    "web-development",
    "ui-ux-design",
    "react",
    "threejs",
    "tailwindcss",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "vite preview --port=3000 --host=0.0.0.0",
    "generate:seo": "node scripts/generate-seo.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.js",
    "build": "node scripts/generate-seo.js && node scripts/generate-sitemap.js && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.36",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^13.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
